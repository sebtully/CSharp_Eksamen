@model DTO.Model.Sag

@{
    ViewData["Title"] = "Create New Case";
}

<h2 class="centered-heading">Create New Case</h2>

<form asp-action="AddSag" method="post" class="centered-form">
    <div class="form-group">
        <label asp-for="Overskrift" class="control-label"></label>
        <input asp-for="Overskrift" class="form-control"/>
        <span asp-validation-for="Overskrift" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Beskrivelse" class="control-label"></label>
        <input asp-for="Beskrivelse" class="form-control"/>
        <span asp-validation-for="Beskrivelse" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AfdelingId" class="control-label">Select Department</label>
        <select asp-for="AfdelingId" class="form-control" asp-items="ViewBag.Afdelinger"></select>
        <span asp-validation-for="AfdelingId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary"/>
    </div>
</form>

<div>
    <a asp-action="Create">Back to Time Registration</a>
</div>

<style>
    .centered-form {
        max-width: 600px;
        margin: 0 auto;
    }

    .centered-heading {
        text-align: center;
    }
</style>