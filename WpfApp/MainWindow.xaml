<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Window" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Margin="10">
            <TabItem Header="Medarbejder Oversigt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="MedarbejderDataGrid" AutoGenerateColumns="True" Height="200" Margin="5" Grid.Row="0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Grid.Row="1">
                        <TextBox x:Name="InitialTextBox" Width="100" Margin="5" Text="Initial" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox x:Name="NavnTextBox" Width="100" Margin="5" Text="Navn" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox x:Name="CprTextBox" Width="100" Margin="5" Text="Cpr" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <Button Content="Tilføj Medarbejder" Style="{StaticResource DefaultButtonStyle}" Click="AddMedarbejder_Click" Margin="5"/>
                        <Button Content="Slet Medarbejder" Style="{StaticResource DefaultButtonStyle}" Click="DeleteMedarbejder_Click" Margin="5"/>
                        <Button Content="Tilføj til afdeling" Style="{StaticResource DefaultButtonStyle}" Click="AddMedarbejderToAfdeling_Click" Margin="5"/>
                    </StackPanel>

                    <DataGrid x:Name="AfdelingDataGrid" AutoGenerateColumns="True" Height="200" Margin="5" Grid.Row="3"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Grid.Row="4">
                        <Button Content="Tilføj Afdeling" Style="{StaticResource DefaultButtonStyle}" Click="AddAfdeling_Click" Margin="5"/>
                        <Button Content="Slet Afdeling" Style="{StaticResource DefaultButtonStyle}" Click="DeleteAfdeling_Click" Margin="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Tidsregistrering Oversigt">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10" Grid.Row="0">
                        <ComboBox x:Name="MedarbejderComboBox" DisplayMemberPath="Navn" SelectedValuePath="MedarbejderId" Width="200" Margin="5"/>
                        <Button Content="Vis Tidsregistreringer" Click="ShowTidsregistreringer_Click" Margin="5" Width="200"/>
                    </StackPanel>

                    <DataGrid x:Name="TidsregistreringDataGrid" AutoGenerateColumns="False" Margin="10" Height="200" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Navn" Binding="{Binding MedarbejderNavn}" Width="*"/>
                            <DataGridTextColumn Header="Initial" Binding="{Binding MedarbejderInitial}" Width="*"/>
                            <DataGridTextColumn Header="Starttid" Binding="{Binding TidsregistreringStart}" Width="*"/>
                            <DataGridTextColumn Header="Sluttid" Binding="{Binding TidsregistreringSlut}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>